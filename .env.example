# Valores reales: configurar en Railway o en un .env local ignorado por Git.
PORT=3000
CHATFUEL_BOT_ID=
CHATFUEL_API_TOKEN=
CHATFUEL_BOOKING_SECRET=
# Identificadores propios; bitrixUserId corresponde al calendario del asesor.
APPOINTMENT_ADVISORS_JSON=[{"id":"asesor-1","name":"Asesor","bitrixUserId":"123"}]
CHATFUEL_BOOKING_FLOW_ID=
APPOINTMENT_SAME_DAY_CUTOFF_HOUR=12
# Mantener false al preparar otro servicio; activar al realizar el cambio.
HANDOFF_SYNC_ENABLED=false
INCOMING_RECOVERY_ENABLED=false

# Registro de clientes en la misma API; MySQL permanece en su servicio aparte.
MYSQL_URL=mysql://usuario:clave@mysql.railway.internal:3306/chatfuel
BITRIX_WEBHOOK_URL=https://tu-portal.bitrix24.com/rest/1/TU_WEBHOOK/
# Opcional si el webhook anterior ya tiene permisos calendar; mismo portal.
BITRIX_CALENDAR_WEBHOOK_URL=
REGISTRAR_CLIENTE_TOKEN=
